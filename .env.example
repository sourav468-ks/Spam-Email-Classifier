# SpamGuard — Environment Variables Template
#
# HOW TO USE:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in every value below with your actual credentials.
#   3. NEVER commit .env to Git — it is listed in .gitignore.
#
# ============================================================================
# Flask
# ============================================================================

# Required: A long random secret string used to sign session cookies.
# Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# ============================================================================
# Google OAuth 2.0
# ============================================================================
# These values come from the Google Cloud Console:
#   Console → APIs & Services → Credentials → Your OAuth Client
#
# You do NOT need to set GOOGLE_CLIENT_ID or GOOGLE_CLIENT_SECRET here.
# They are read directly from credentials.json (downloaded from Google Cloud).
# Just ensure credentials.json is placed at the project root.
#
# The redirect URI MUST exactly match what you configured in Google Cloud.
# For local development, use:
GOOGLE_REDIRECT_URI=http://localhost:5000/oauth2callback

# ============================================================================
# Gmail Analysis
# ============================================================================

# Optional: Maximum emails to fetch and classify per request (default: 10).
# Hard-capped at 50 regardless of this value.
GMAIL_MAX_RESULTS=10
